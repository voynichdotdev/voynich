CLUSTER=mainnet-beta
SOLANA_RPC_URL=
PROGRAM_ID=
ATTESTATION_PROGRAM_ID=
LOOKUP_TABLE=
ENCLAVE_HOST=::
ENCLAVE_PORT=9707
# Railway injects PORT (overrides ENCLAVE_PORT).
ENCLAVE_ENDPOINT=
# Optional lowercase region tag (e.g. us-east, eu-west) checked against model Policy.allowed_regions.
# ENCLAVE_REGION=us-east
# Mount a persistent Railway volume at /var/lib/voynich with RAILWAY_RUN_UID=0.
ENCLAVE_STATE_PATH=/var/lib/voynich/enclave.sealed.json
RAILWAY_RUN_UID=0
ENCLAVE_WAIT_POLL_MS=60000
ENCLAVE_POLL_MS=5000
ENCLAVE_RPC_RPS=10
ENCLAVE_SCAN_INTERVAL_MS=10000
OPERATOR_KEYPAIR=
DEV_ATTESTATION_ROOT_KEYPAIR=
DEV_SEALING_KEY=
