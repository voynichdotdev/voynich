# API and shared services. Preserve the existing .env while the fixture server is in use.
MODE=fixture
HOST=127.0.0.1
PORT=9702
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:9700,http://localhost:9700,http://127.0.0.1:9701,http://localhost:9701
PUBLIC_API_URL=http://127.0.0.1:9702
CLUSTER=localnet
SOLANA_RPC_URL=http://127.0.0.1:9704
# Required for remote RPC endpoints; local RPC uses the engine's local defaults.
RPC_RPS=
RPC_SCAN_INTERVAL_MS=
# IDs default to generated IDLs; setup writes public values into .local/services.env.
PROGRAM_ID=
ATTESTATION_PROGRAM_ID=
ATTESTATION_RECORD_LAYOUT_VERSION=
LOOKUP_TABLE=
# Observed from chain by services; explicit remote setup inputs, never launch guesses.
FEE_RECIPIENT=
PROTOCOL_SHARE_BPS=
CALL_DEADLINE_SLOTS=
# Crank signing files. Buyback is idle without a token mint and always idle on localnet.
KEEPER_KEYPAIR=
FEE_RECIPIENT_KEYPAIR=
TOKEN_MINT=
JUPITER_API_KEY=
BUYBACK_INTERVAL_SECONDS=
BUYBACK_RESERVE_LAMPORTS=
BUYBACK_SLIPPAGE_BPS=
BUYBACK_AMOUNT_BASE_UNITS=
# SDK and CLI. VOYNICH_KEYPAIR is a file; CLI otherwise uses the Solana CLI's keypair path.
VOYNICH_API_URL=http://127.0.0.1:9702
VOYNICH_KEYPAIR=
VOYNICH_PASSWORD=
# Operator runtime. Separate state path and port for each enclave.
OPERATOR_KEYPAIR=
DEV_ATTESTATION_ROOT_KEYPAIR=
DEV_SEALING_KEY=
ENCLAVE_STATE_PATH=.local/enclave.sealed.json
ENCLAVE_ENDPOINT=http://127.0.0.1:9707
ENCLAVE_PORT=9707
ENCLAVE_HOST=127.0.0.1
ENCLAVE_POLL_MS=5000
ENCLAVE_RPC_RPS=
ENCLAVE_SCAN_INTERVAL_MS=
# Set explicit keypair paths for setup actors (defaults to .local/keys/<actor>.json).
DEPLOYER_KEYPAIR=
OWNER_KEYPAIR=
CALLER_KEYPAIR=
SETUP_STATE_PATH=
SETUP_RPC_RPS=
SETUP_SCAN_INTERVAL_MS=
# Explicit remote setup inputs. Localnet uses named constants in scripts/setup.ts.
# Default local funding: owner/caller 10 SOL each, operator 2 SOL.
# SETUP_ACTOR_FUNDING_LAMPORTS explicitly overrides all three targets.
SKETCH_OPERATOR_SHARE_BPS=
SKETCH_PRICE_LAMPORTS=
ATTEST_MAX_REPORT_AGE_SLOTS=
ATTEST_RECORD_LIFETIME_SLOTS=
SETUP_ACTOR_FUNDING_LAMPORTS=
UPLOAD_FUNDING_LAMPORTS=
